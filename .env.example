# Environment Configuration

# Common Settings
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Logging
LOG_LEVEL=Information
ENABLE_CONSOLE_LOGGING=true

# Spectator Configuration
SPECTATOR_PORT=5185
SPECTATOR_GRPC_PORT=5186
SPECTATOR_MAX_EVENTS_PER_MATCH=10000

# LocalCrm Configuration
LOCALCRM_API_PORT=5057
LOCALCRM_APP_PORT=5209
LOCALCRM_DB_PATH=data/cloud.db
LOCALCRM_SYNC_INTERVAL_SECONDS=30

# PromptGateway Configuration
PROMPTGATEWAY_PORT=5047
PROMPTGATEWAY_RATE_LIMIT_TOKENS=8000
PROMPTGATEWAY_RATE_LIMIT_WINDOW_HOURS=1
PROMPTGATEWAY_ENABLE_PII_MASKING=true
PROMPTGATEWAY_ENABLE_AUDIT_LOG=true

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_HEALTH_CHECKS=true
ENABLE_METRICS=true

# Performance
DOTNET_SYSTEM_NET_HTTP_SOCKETSHTTPHANDLER_HTTP2SUPPORT=true
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
