{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "llm": {
        "ClusterId": "mock",
        "Match": { "Path": "/v1/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/_upstream/v1/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "mock": {
        "Destinations": {
          "d1": { "Address": "http://127.0.0.1:5047/" }
        }
      }
    }
  }
}
