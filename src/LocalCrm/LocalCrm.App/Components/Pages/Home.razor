@page "/"
@rendermode InteractiveServer
@using LocalCrm.Shared
@inject LocalStore Store
@inject SyncClient Sync
@inject IJSRuntime Js

<PageTitle>Yerel CRM</PageTitle>

<div class="topbar">
    <div class="brand"><span class="brand-mark">C</span> LocalCrm</div>
    <nav class="app-nav">
        <a href="http://localhost:5185">Maç</a>
        <a class="on" href="/">CRM</a>
        <a href="http://localhost:5047">Kapı</a>
    </nav>
    <div class="device">Bu cihaz: <code>@Store.DeviceId</code></div>
</div>

<div class="page">
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="banner @_statusKind">@_status</div>
    }

    <div class="toolbar">
        <input placeholder="Ad, şirket, e-posta veya telefon ara…" @bind="_q" @bind:event="oninput" />
        <select @bind="_sort">
            <option value="name">Ada göre</option>
            <option value="company">Şirkete göre</option>
            <option value="recent">Son güncelleme</option>
        </select>
        <button type="button" @onclick="SaveNew">+ Yeni kişi</button>
        <button type="button" class="ghost" @onclick="SyncNow">Bulut ile senkron</button>
        <span class="count">@Visible.Count() kişi</span>
    </div>

    <div class="grid">
        <section class="panel">
            <header>
                <h2>Rehber</h2>
                <span>İnternet olmasa da kayıt tutulur</span>
            </header>
            <div class="list">
                @if (!Visible.Any())
                {
                    <div class="empty">Eşleşen kişi yok. Yeni kişi ekleyin veya aramayı temizleyin.</div>
                }
                @foreach (var c in Visible)
                {
                    <button type="button" class="card @(c.Id == _selected?.Id ? "on" : null)" @onclick="() => Select(c)">
                        <strong>@(string.IsNullOrWhiteSpace(c.Name.Value) ? "(isimsiz)" : c.Name.Value)</strong>
                        <span>@(string.IsNullOrWhiteSpace(c.Company.Value) ? "Şirket yok" : c.Company.Value)</span>
                        <span>@(string.IsNullOrWhiteSpace(c.Email.Value) ? c.Phone.Value : c.Email.Value)</span>
                    </button>
                }
            </div>
        </section>

        <section class="panel">
            @if (_selected is null)
            {
                <div class="empty tall">Soldan bir kişi seçin veya yeni kişi oluşturun. Aynı kişide iki cihaz farklı alanları değiştirirse ikisi de kalır.</div>
            }
            else
            {
                <header>
                    <h2>Kişi kartı @(IsDirty ? "· kaydedilmedi" : "")</h2>
                    <button type="button" class="danger" @onclick="DeleteSelected">Sil</button>
                </header>
                <label>Ad
                    <input @bind="_name" @bind:event="oninput" />
                    <small>@Stamp(_selected.Name)</small>
                </label>
                <label>E-posta
                    <input @bind="_email" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_email))
                    {
                        <small><a href="mailto:@_email">@_email</a> · @Stamp(_selected.Email)</small>
                    }
                    else
                    {
                        <small>@Stamp(_selected.Email)</small>
                    }
                </label>
                <label>Telefon
                    <input @bind="_phone" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_phone))
                    {
                        <small><a href="tel:@_phone">Ara</a> · @Stamp(_selected.Phone)</small>
                    }
                    else
                    {
                        <small>@Stamp(_selected.Phone)</small>
                    }
                </label>
                <label>Şirket
                    <input @bind="_company" @bind:event="oninput" />
                    <small>@Stamp(_selected.Company)</small>
                </label>
                <label>Not
                    <textarea @bind="_notes" @bind:event="oninput"></textarea>
                    <small>@Stamp(_selected.Notes)</small>
                </label>
                <button type="button" class="save" @onclick="Persist">@(IsDirty ? "Değişiklikleri kaydet" : "Yerelde kaydet")</button>
            }
        </section>
    </div>
</div>

@code {
    List<ContactRecord> _list = [];
    ContactRecord? _selected;
    string _name = "", _email = "", _phone = "", _company = "", _notes = "", _status = "", _statusKind = "", _q = "", _sort = "name";

    bool IsDirty =>
        _selected is not null &&
        (_name != _selected.Name.Value ||
         _email != _selected.Email.Value ||
         _phone != _selected.Phone.Value ||
         _company != _selected.Company.Value ||
         _notes != _selected.Notes.Value);

    IEnumerable<ContactRecord> Visible
    {
        get
        {
            var items = string.IsNullOrWhiteSpace(_q)
                ? _list.AsEnumerable()
                : _list.Where(c =>
                    (c.Name.Value + " " + c.Email.Value + " " + c.Company.Value + " " + c.Phone.Value)
                        .Contains(_q, StringComparison.OrdinalIgnoreCase));
            return _sort switch
            {
                "company" => items.OrderBy(c => c.Company.Value).ThenBy(c => c.Name.Value),
                "recent" => items.OrderByDescending(LastTouch),
                _ => items.OrderBy(c => c.Name.Value)
            };
        }
    }

    protected override void OnInitialized()
    {
        _list = Store.All().ToList();
        if (_list.Count > 0)
        {
            ApplySelection(_list[0]);
        }
    }

    static DateTimeOffset LastTouch(ContactRecord c) => new[]
    {
        c.Name.UpdatedAt, c.Email.UpdatedAt, c.Phone.UpdatedAt, c.Company.UpdatedAt, c.Notes.UpdatedAt
    }.Max();

    static string Stamp(FieldClock field) =>
        field.UpdatedAt == default
            ? "Henüz kaydedilmedi"
            : $"Son yazan {field.DeviceId} · {field.UpdatedAt.LocalDateTime:dd MMM HH:mm}";

    async Task Select(ContactRecord c)
    {
        if (_selected is not null && _selected.Id != c.Id && IsDirty)
        {
            var leave = await Js.InvokeAsync<bool>("confirm", "Kaydedilmemiş değişiklikler var. Yine de kişi değiştirilsin mi?");
            if (!leave) return;
        }

        ApplySelection(c);
    }

    void ApplySelection(ContactRecord c)
    {
        _selected = c;
        _name = c.Name.Value;
        _email = c.Email.Value;
        _phone = c.Phone.Value;
        _company = c.Company.Value;
        _notes = c.Notes.Value;
    }

    void SaveNew()
    {
        var device = Store.DeviceId;
        var c = new ContactRecord
        {
            Id = Guid.NewGuid(),
            Name = FieldMerger.Touch("Yeni kişi", device)
        };
        Store.Save(c);
        _list = Store.All().ToList();
        _selected = c;
        _name = c.Name.Value;
        _email = _phone = _company = _notes = "";
        Flash("Yeni kişi yerelde oluşturuldu. Adı düzenleyip kaydedin.", "ok");
    }

    void Persist()
    {
        if (_selected is null) return;
        var d = Store.DeviceId;
        FieldClock StampField(FieldClock field, string value) =>
            field.Value == value ? field : FieldMerger.Touch(value, d);

        _selected.Name = StampField(_selected.Name, _name);
        _selected.Email = StampField(_selected.Email, _email);
        _selected.Phone = StampField(_selected.Phone, _phone);
        _selected.Company = StampField(_selected.Company, _company);
        _selected.Notes = StampField(_selected.Notes, _notes);
        Store.Save(_selected);
        _list = Store.All().ToList();
        Flash("Yerelde kaydedildi. Bulut ile senkron’a basınca diğer cihazlara gider.", "ok");
    }

    async Task DeleteSelected()
    {
        if (_selected is null) return;
        var ok = await Js.InvokeAsync<bool>("confirm", $"“{_selected.Name.Value}” silinsin mi?");
        if (!ok) return;
        _selected.DeletedAt = DateTimeOffset.UtcNow;
        Store.Save(_selected);
        _list = Store.All().ToList();
        _selected = _list.FirstOrDefault();
        if (_selected is not null)
        {
            _name = _selected.Name.Value;
            _email = _selected.Email.Value;
            _phone = _selected.Phone.Value;
            _company = _selected.Company.Value;
            _notes = _selected.Notes.Value;
        }
        Flash("Kişi bu cihazdan kaldırıldı.", "ok");
    }

    async Task SyncNow()
    {
        try
        {
            Flash(await Sync.SyncAsync(), "ok");
            _list = Store.All().ToList();
            if (_selected is not null)
            {
                _selected = _list.FirstOrDefault(x => x.Id == _selected.Id);
                if (_selected is not null)
                {
                    _name = _selected.Name.Value;
                    _email = _selected.Email.Value;
                    _phone = _selected.Phone.Value;
                    _company = _selected.Company.Value;
                    _notes = _selected.Notes.Value;
                }
            }
        }
        catch (Exception ex)
        {
            Flash("Senkron başarısız. LocalCrm API (5057) ayakta mı? " + ex.Message, "error");
        }
    }

    void Flash(string text, string kind)
    {
        _status = text;
        _statusKind = kind;
    }
}
