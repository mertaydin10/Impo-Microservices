@page "/"
@rendermode InteractiveServer
@using LocalCrm.Shared
@inject LocalStore Store
@inject SyncClient Sync

<PageTitle>Yerel CRM</PageTitle>

<h1>Rehber defteri (çevrimdışı CRM)</h1>
<p>WhatsApp gibi: internet olmasa da kişi kaydedersin. “Bulut ile senkron” deyince telefonla bilgisayar aynı defteri birleştirir. Aynı kişide sen e-postayı, başka cihaz telefonu değiştirdiyse <strong>ikisi de kalır</strong> (biri diğerini ezmez).</p>
<p class="muted">Bu cihazın adı: <code>@Store.DeviceId</code></p>
<p class="muted">1) Yeni kişi → 2) alanları doldur, Kaydet → 3) CRM API (<code>localhost:5057</code>) açıkken Bulut ile senkron.</p>

<div class="bar">
    <button @onclick="SaveNew">Yeni kişi</button>
    <button class="ghost" @onclick="SyncNow">Bulut ile senkron</button>
    <span>@_status</span>
</div>

<div class="grid">
    <section>
        <h3>Kişiler</h3>
        @foreach (var c in _list)
        {
            <button class="card @(c.Id == _selected?.Id ? "on" : null)" @onclick="() => Select(c)">
                <strong>@(string.IsNullOrWhiteSpace(c.Name.Value) ? "(isimsiz)" : c.Name.Value)</strong>
                <span>@c.Email.Value</span>
            </button>
        }
    </section>
    <section>
        @if (_selected is not null)
        {
            <h3>Alanlar</h3>
            <label>Ad <input @bind="_name" @bind:event="oninput" /></label>
            <label>E-posta <input @bind="_email" @bind:event="oninput" /></label>
            <label>Telefon <input @bind="_phone" @bind:event="oninput" /></label>
            <label>Şirket <input @bind="_company" @bind:event="oninput" /></label>
            <label>Not <textarea @bind="_notes" @bind:event="oninput"></textarea></label>
            <p class="muted">Her alan kendi saat damgasını taşır. İki cihaz aynı kişiyi farklı alanlardan güncellerse ikisi de korunur.</p>
            <button @onclick="Persist">Kaydet (yerel SQLite)</button>
        }
    </section>
</div>

@code {
    List<ContactRecord> _list = [];
    ContactRecord? _selected;
    string _name = "", _email = "", _phone = "", _company = "", _notes = "", _status = "";

    protected override void OnInitialized() => _list = Store.All().ToList();

    void Select(ContactRecord c)
    {
        _selected = c;
        _name = c.Name.Value;
        _email = c.Email.Value;
        _phone = c.Phone.Value;
        _company = c.Company.Value;
        _notes = c.Notes.Value;
    }

    void SaveNew()
    {
        var device = Store.DeviceId;
        var c = new ContactRecord
        {
            Id = Guid.NewGuid(),
            Name = FieldMerger.Touch("Yeni kişi", device)
        };
        Store.Save(c);
        _list = Store.All().ToList();
        Select(c);
    }

    void Persist()
    {
        if (_selected is null) return;
        var d = Store.DeviceId;
        FieldClock Stamp(FieldClock field, string value) =>
            field.Value == value ? field : FieldMerger.Touch(value, d);

        _selected.Name = Stamp(_selected.Name, _name);
        _selected.Email = Stamp(_selected.Email, _email);
        _selected.Phone = Stamp(_selected.Phone, _phone);
        _selected.Company = Stamp(_selected.Company, _company);
        _selected.Notes = Stamp(_selected.Notes, _notes);
        Store.Save(_selected);
        _list = Store.All().ToList();
        _status = "Yerelde kaydedildi.";
    }

    async Task SyncNow()
    {
        try
        {
            _status = await Sync.SyncAsync();
            _list = Store.All().ToList();
            if (_selected is not null)
            {
                _selected = _list.FirstOrDefault(x => x.Id == _selected.Id);
                if (_selected is not null) Select(_selected);
            }
        }
        catch (Exception ex)
        {
            _status = "Senkron başarısız (API ayakta mı?): " + ex.Message;
        }
    }
}
