@page "/"
@rendermode InteractiveServer
@using LocalCrm.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject LocalStore Store
@inject SyncClient Sync
@inject IJSRuntime Js

<PageTitle>Yerel CRM</PageTitle>

<div class="topbar">
    <div class="brand"><span class="brand-mark">C</span> LocalCrm</div>
    <nav class="app-nav">
        <a href="http://localhost:5185">Maç</a>
        <a class="on" href="/">CRM</a>
        <a href="http://localhost:5047">Kapı</a>
    </nav>
    <div class="device">
        Bu cihaz: <code>@Store.DeviceId</code>
        @if (_lastSyncAt is not null)
        {
            <span> · Son senkron @_lastSyncAt.Value.LocalDateTime.ToString("dd MMM HH:mm")</span>
        }
    </div>
</div>

<div class="page">
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="banner @_statusKind">@_status</div>
    }

    <div class="toolbar">
        <input id="crmSearch" placeholder="Ad, şirket, e-posta, telefon veya not ara…" @bind="_q" @bind:event="oninput" />
        <select @bind="_sort">
            <option value="name">Ada göre</option>
            <option value="company">Şirkete göre</option>
            <option value="recent">Son güncelleme</option>
            <option value="favorites">Favoriler üstte</option>
        </select>
        <button type="button" class="ghost @(_favoritesOnly ? "on" : null)" @onclick="ToggleFavoritesOnly">★ Favoriler</button>
        <button type="button" class="ghost @(_showDeleted ? "on" : null)" @onclick="ToggleShowDeleted">Silinenler</button>
        <button type="button" @onclick="SaveNew">+ Yeni kişi</button>
        <button type="button" class="ghost" @onclick="DuplicateSelected" disabled="@(_selected is null || _selected.DeletedAt != default)">Kopyasını oluştur</button>
        <button type="button" class="ghost" @onclick="SyncNow">Bulut ile senkron</button>
        <button type="button" class="ghost" @onclick="ExportCsv">CSV indir</button>
        <label class="ghost" style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;margin:0">
            CSV yükle
            <InputFile OnChange="ImportCsv" accept=".csv,text/csv" style="display:none" />
        </label>
        <span class="count">@Visible.Count() kişi · N yeni · / ara</span>
    </div>

    @if (Companies.Any())
    {
        <div class="chips">
            <button type="button" class="@(_companyFilter == "" ? "on" : null)" @onclick="ClearCompanyFilter">Tüm şirketler</button>
            @foreach (var company in Companies)
            {
                <button type="button" class="@(_companyFilter == company ? "on" : null)" @onclick="() => _companyFilter = company">@company</button>
            }
        </div>
    }

    <div class="grid">
        <section class="panel">
            <header>
                <h2>Rehber</h2>
                <span>İnternet olmasa da kayıt tutulur</span>
            </header>
            <div class="list">
                @if (!Visible.Any())
                {
                    <div class="empty">Eşleşen kişi yok. Yeni kişi ekleyin veya aramayı temizleyin.</div>
                }
                @foreach (var c in Visible)
                {
                    <button type="button" class="card @(c.Id == _selected?.Id ? "on" : null)" @onclick="() => Select(c)">
                        <strong>@(_favorites.Contains(c.Id) ? "★ " : "")@(string.IsNullOrWhiteSpace(c.Name.Value) ? "(isimsiz)" : c.Name.Value)@(c.DeletedAt != default ? " · silindi" : "")</strong>
                        <span>@(string.IsNullOrWhiteSpace(c.Company.Value) ? "Şirket yok" : c.Company.Value)</span>
                        <span>@(string.IsNullOrWhiteSpace(c.Email.Value) ? c.Phone.Value : c.Email.Value)</span>
                    </button>
                }
            </div>
        </section>

        <section class="panel">
            @if (_selected is null)
            {
                <div class="empty tall">Soldan bir kişi seçin veya yeni kişi oluşturun. Aynı kişide iki cihaz farklı alanları değiştirirse ikisi de kalır.</div>
            }
            else
            {
                <header>
                    <h2>Kişi kartı @(IsDirty ? "· kaydedilmedi" : "")</h2>
                    <div class="header-actions">
                        <button type="button" class="ghost" @onclick="ToggleFavorite">@(_favorites.Contains(_selected.Id) ? "★ Favoride" : "☆ Favoriye ekle")</button>
                        <button type="button" class="ghost" @onclick="CopyContact">Kopyala</button>
                        @if (_selected.DeletedAt != default)
                        {
                            <button type="button" class="ghost" @onclick="RestoreSelected">Geri al</button>
                        }
                        else
                        {
                            <button type="button" class="danger" @onclick="DeleteSelected">Sil</button>
                        }
                    </div>
                </header>
                <label>Ad
                    <input @bind="_name" @bind:event="oninput" />
                    <small>@Stamp(_selected.Name)</small>
                </label>
                <label>E-posta
                    <input @bind="_email" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_email))
                    {
                        <small><a href="mailto:@_email">@_email</a> · @Stamp(_selected.Email)</small>
                    }
                    else
                    {
                        <small>@Stamp(_selected.Email)</small>
                    }
                </label>
                <label>Telefon
                    <input @bind="_phone" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_phone))
                    {
                        <small><a href="tel:@_phone">Ara</a> · @Stamp(_selected.Phone)</small>
                    }
                    else
                    {
                        <small>@Stamp(_selected.Phone)</small>
                    }
                </label>
                <label>Şirket
                    <input @bind="_company" @bind:event="oninput" />
                    <small>@Stamp(_selected.Company)</small>
                </label>
                <label>Not
                    <textarea @bind="_notes" @bind:event="oninput"></textarea>
                    <small>@Stamp(_selected.Notes)</small>
                </label>
                <button type="button" class="save" @onclick="Persist">@(IsDirty ? "Değişiklikleri kaydet" : "Yerelde kaydet")</button>
            }
        </section>
    </div>
</div>

@code {
    List<ContactRecord> _list = [];
    HashSet<Guid> _favorites = [];
    ContactRecord? _selected;
    DateTimeOffset? _lastSyncAt;
    string _name = "", _email = "", _phone = "", _company = "", _notes = "", _status = "", _statusKind = "", _q = "", _sort = "favorites", _companyFilter = "";
    bool _favoritesOnly;
    bool _showDeleted;

    void ClearCompanyFilter() => _companyFilter = "";
    void ToggleFavoritesOnly() => _favoritesOnly = !_favoritesOnly;
    void ToggleShowDeleted()
    {
        _showDeleted = !_showDeleted;
        ReloadList();
    }

    void ReloadList()
    {
        _list = Store.All(includeDeleted: _showDeleted).ToList();
        if (_selected is null)
        {
            return;
        }

        var current = _list.FirstOrDefault(c => c.Id == _selected.Id);
        if (current is not null)
        {
            ApplySelection(current);
            return;
        }

        _selected = _list.FirstOrDefault();
        if (_selected is not null)
        {
            ApplySelection(_selected);
        }
    }

    IEnumerable<string> Companies =>
        _list.Select(c => c.Company.Value)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value)
            .Take(12);

    bool IsDirty =>
        _selected is not null &&
        (_name != _selected.Name.Value ||
         _email != _selected.Email.Value ||
         _phone != _selected.Phone.Value ||
         _company != _selected.Company.Value ||
         _notes != _selected.Notes.Value);

    IEnumerable<ContactRecord> Visible
    {
        get
        {
            var items = string.IsNullOrWhiteSpace(_q)
                ? _list.AsEnumerable()
                : _list.Where(c =>
                    (c.Name.Value + " " + c.Email.Value + " " + c.Company.Value + " " + c.Phone.Value + " " + c.Notes.Value)
                        .Contains(_q, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(_companyFilter))
            {
                items = items.Where(c => c.Company.Value.Equals(_companyFilter, StringComparison.OrdinalIgnoreCase));
            }
            if (_favoritesOnly)
            {
                items = items.Where(c => _favorites.Contains(c.Id));
            }
            if (_showDeleted)
            {
                items = items.Where(c => c.DeletedAt != default);
            }

            items = _sort switch
            {
                "company" => items.OrderBy(c => c.Company.Value).ThenBy(c => c.Name.Value),
                "recent" => items.OrderByDescending(LastTouch),
                "favorites" => items.OrderByDescending(c => _favorites.Contains(c.Id)).ThenBy(c => c.Name.Value),
                _ => items.OrderBy(c => c.Name.Value)
            };
            return items;
        }
    }

    protected override void OnInitialized()
    {
        _list = Store.All(includeDeleted: _showDeleted).ToList();
        _favorites = Store.GetFavorites();
        _lastSyncAt = Store.GetLastSyncAt();
        if (_list.Count > 0)
        {
            ApplySelection(_list[0]);
        }
    }

    static DateTimeOffset LastTouch(ContactRecord c) => new[]
    {
        c.Name.UpdatedAt, c.Email.UpdatedAt, c.Phone.UpdatedAt, c.Company.UpdatedAt, c.Notes.UpdatedAt
    }.Max();

    static string Stamp(FieldClock field) =>
        field.UpdatedAt == default
            ? "Henüz kaydedilmedi"
            : $"Son yazan {field.DeviceId} · {field.UpdatedAt.LocalDateTime:dd MMM HH:mm}";

    async Task Select(ContactRecord c)
    {
        if (_selected is not null && _selected.Id != c.Id && IsDirty)
        {
            var leave = await Js.InvokeAsync<bool>("confirm", "Kaydedilmemiş değişiklikler var. Yine de kişi değiştirilsin mi?");
            if (!leave) return;
        }

        ApplySelection(c);
    }

    void ApplySelection(ContactRecord c)
    {
        _selected = c;
        _name = c.Name.Value;
        _email = c.Email.Value;
        _phone = c.Phone.Value;
        _company = c.Company.Value;
        _notes = c.Notes.Value;
    }

    void SaveNew()
    {
        var device = Store.DeviceId;
        var c = new ContactRecord
        {
            Id = Guid.NewGuid(),
            Name = FieldMerger.Touch("Yeni kişi", device)
        };
        Store.Save(c);
        _selected = c;
        ReloadList();
        ApplySelection(c);
        _email = _phone = _company = _notes = "";
        Flash("Yeni kişi yerelde oluşturuldu. Adı düzenleyip kaydedin.", "ok");
    }

    void DuplicateSelected()
    {
        if (_selected is null) return;
        var device = Store.DeviceId;
        var copy = new ContactRecord
        {
            Id = Guid.NewGuid(),
            Name = FieldMerger.Touch(string.IsNullOrWhiteSpace(_name) ? "Kişi kopyası" : $"{_name} (kopya)", device),
            Email = FieldMerger.Touch(_email, device),
            Phone = FieldMerger.Touch(_phone, device),
            Company = FieldMerger.Touch(_company, device),
            Notes = FieldMerger.Touch(_notes, device)
        };
        Store.Save(copy);
        _selected = copy;
        ReloadList();
        ApplySelection(copy);
        Flash("Kişinin kopyası oluşturuldu. Düzenleyip kaydedin.", "ok");
    }

    void ToggleFavorite()
    {
        if (_selected is null) return;
        var next = !_favorites.Contains(_selected.Id);
        Store.SetFavorite(_selected.Id, next);
        _favorites = Store.GetFavorites();
        Flash(next ? "Favorilere eklendi." : "Favorilerden çıkarıldı.", "ok");
    }

    async Task CopyContact()
    {
        if (_selected is null) return;
        var text = string.Join("\n", new[]
        {
            _name,
            string.IsNullOrWhiteSpace(_company) ? null : _company,
            string.IsNullOrWhiteSpace(_email) ? null : _email,
            string.IsNullOrWhiteSpace(_phone) ? null : _phone,
            string.IsNullOrWhiteSpace(_notes) ? null : _notes
        }.Where(line => !string.IsNullOrWhiteSpace(line)));
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Flash("Kişi bilgisi panoya kopyalandı.", "ok");
    }

    void Persist()
    {
        if (_selected is null) return;
        var d = Store.DeviceId;
        FieldClock StampField(FieldClock field, string value) =>
            field.Value == value ? field : FieldMerger.Touch(value, d);

        _selected.Name = StampField(_selected.Name, _name);
        _selected.Email = StampField(_selected.Email, _email);
        _selected.Phone = StampField(_selected.Phone, _phone);
        _selected.Company = StampField(_selected.Company, _company);
        _selected.Notes = StampField(_selected.Notes, _notes);
        Store.Save(_selected);
        ReloadList();
        var duplicateEmail = !string.IsNullOrWhiteSpace(_email) &&
            _list.Any(c => c.Id != _selected.Id && c.Email.Value.Equals(_email, StringComparison.OrdinalIgnoreCase));
        var duplicatePhone = !string.IsNullOrWhiteSpace(_phone) &&
            _list.Any(c => c.Id != _selected.Id && c.Phone.Value.Equals(_phone, StringComparison.OrdinalIgnoreCase));
        Flash(
            duplicateEmail || duplicatePhone
                ? $"Kaydedildi. {(duplicateEmail ? "E-posta " : "")}{(duplicateEmail && duplicatePhone ? "ve " : "")}{(duplicatePhone ? "telefon " : "")}başka kişide de var."
                : "Yerelde kaydedildi. ⌘S / Ctrl+S ile de kaydedebilirsiniz.",
            duplicateEmail || duplicatePhone ? "error" : "ok");
    }

    async Task RestoreSelected()
    {
        if (_selected is null || _selected.DeletedAt == default) return;
        _selected.DeletedAt = default;
        Store.Save(_selected);
        ReloadList();
        Flash("Kişi geri yüklendi.", "ok");
    }

    async Task ExportCsv()
    {
        var header = "Ad,Eposta,Telefon,Sirket,Not";
        var lines = Visible.Select(c => string.Join(",",
            Csv(c.Name.Value), Csv(c.Email.Value), Csv(c.Phone.Value), Csv(c.Company.Value), Csv(c.Notes.Value)));
        await Js.InvokeVoidAsync("impoDownload", "kisiler.csv", header + "\n" + string.Join("\n", lines));
        Flash($"{Visible.Count()} kişi CSV olarak indirildi.", "ok");
    }

    async Task ImportCsv(InputFileChangeEventArgs args)
    {
        await using var stream = args.File.OpenReadStream(maxAllowedSize: 2_000_000);
        using var reader = new StreamReader(stream);
        var text = await reader.ReadToEndAsync();
        var rows = text.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries);
        if (rows.Length <= 1)
        {
            Flash("CSV boş veya sadece başlık satırı var.", "error");
            return;
        }

        var device = Store.DeviceId;
        var imported = 0;
        foreach (var row in rows.Skip(1))
        {
            var cols = ParseCsvLine(row);
            if (cols.Count == 0 || cols.All(string.IsNullOrWhiteSpace)) continue;
            var name = cols.ElementAtOrDefault(0)?.Trim() ?? "";
            if (string.IsNullOrWhiteSpace(name)) continue;
            if (name.Equals("Ad", StringComparison.OrdinalIgnoreCase) ||
                name.Equals("name", StringComparison.OrdinalIgnoreCase)) continue;
            var contact = new ContactRecord
            {
                Id = Guid.NewGuid(),
                Name = FieldMerger.Touch(name, device),
                Email = FieldMerger.Touch(cols.ElementAtOrDefault(1)?.Trim() ?? "", device),
                Phone = FieldMerger.Touch(cols.ElementAtOrDefault(2)?.Trim() ?? "", device),
                Company = FieldMerger.Touch(cols.ElementAtOrDefault(3)?.Trim() ?? "", device),
                Notes = FieldMerger.Touch(cols.ElementAtOrDefault(4)?.Trim() ?? "", device)
            };
            Store.Save(contact);
            imported++;
        }

        ReloadList();
        Flash(imported == 0 ? "İçe aktarılacak satır bulunamadı." : $"{imported} kişi CSV’den eklendi.", imported == 0 ? "error" : "ok");
    }

    static List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        var current = new System.Text.StringBuilder();
        var inQuotes = false;
        for (var i = 0; i < line.Length; i++)
        {
            var ch = line[i];
            if (ch == '"')
            {
                if (inQuotes && i + 1 < line.Length && line[i + 1] == '"')
                {
                    current.Append('"');
                    i++;
                }
                else
                {
                    inQuotes = !inQuotes;
                }
            }
            else if (ch == ',' && !inQuotes)
            {
                result.Add(current.ToString());
                current.Clear();
            }
            else
            {
                current.Append(ch);
            }
        }
        result.Add(current.ToString());
        return result;
    }

    static string Csv(string value)
    {
        var text = value.Replace("\"", "\"\"");
        return text.Contains(',') || text.Contains('"') || text.Contains('\n') ? $"\"{text}\"" : text;
    }

    async Task DeleteSelected()
    {
        if (_selected is null) return;
        var ok = await Js.InvokeAsync<bool>("confirm", $"“{_selected.Name.Value}” silinsin mi?");
        if (!ok) return;
        _selected.DeletedAt = DateTimeOffset.UtcNow;
        Store.Save(_selected);
        if (_favorites.Contains(_selected.Id))
        {
            Store.SetFavorite(_selected.Id, false);
            _favorites = Store.GetFavorites();
        }
        ReloadList();
        Flash("Kişi bu cihazdan kaldırıldı.", "ok");
    }

    async Task SyncNow()
    {
        try
        {
            Flash(await Sync.SyncAsync(), "ok");
            Store.SetLastSyncAt(DateTimeOffset.UtcNow);
            _lastSyncAt = Store.GetLastSyncAt();
            ReloadList();
        }
        catch (Exception ex)
        {
            Flash("Senkron başarısız. LocalCrm API (5057) ayakta mı? " + ex.Message, "error");
        }
    }

    void Flash(string text, string kind)
    {
        _status = text;
        _statusKind = kind;
    }
}
